{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "0.3.7",
  "description": "__MSG_appDesc__",
  "default_locale": "es",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_appName__",
    "default_icon": {
      "16": "icons/archivero-16.png",
      "32": "icons/archivero-32.png",
      "48": "icons/archivero-48.png",
      "128": "icons/archivero-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.js",
        "popup-theme.js",
        "popup-arrow.svg",
        "assets/*",
        "chunks/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "save-page": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_cmdSave__"
    }
  },
  "icons": {
    "16": "icons/archivero-16.png",
    "32": "icons/archivero-32.png",
    "48": "icons/archivero-48.png",
    "128": "icons/archivero-128.png"
  }
}
